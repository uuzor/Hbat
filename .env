# ──────────────────────────────────────────────────────────────────
#  Hedera Options Vault — Environment Configuration
# ──────────────────────────────────────────────────────────────────

# ── AI Provider (set ONE of these)
OPENROUTER_API_KEY=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
# ANTHROPIC_API_KEY=sk-ant-...
# GEMINI_API_KEY=...

# Model to use via OpenRouter (default: anthropic/claude-opus-4-6)
# Other options: openai/gpt-4o, google/gemini-2.0-flash, meta-llama/llama-3.3-70b-instruct
OPENROUTER_MODEL=anthropic/claude-opus-4-6

# ── Hedera Network Config
HEDERA_NETWORK=testnet
HEDERA_TESTNET_RPC=https://testnet.hashio.io/api
HEDERA_MAINNET_RPC=https://mainnet.hashio.io/api
HEDERA_MIRROR_NODE=https://testnet.mirrornode.hedera.com

# ── Hedera Operator (only needed for signed transactions — optional for read-only)
# OPERATOR_ACCOUNT_ID=0.0.XXXXXX
# OPERATOR_PRIVATE_KEY=0x...

# ── Deployed Contract Addresses (fill after deployment)
OPTIONS_VAULT_ADDRESS=
OPTION_TOKEN_ADDRESS=

# ── Pyth Oracle
PYTH_HERMES_ENDPOINT=https://hermes.pyth.network
PYTH_CONTRACT_ADDRESS=0xA2aa501b19aff244D90cc15a4Cf739D2725B5729

# ── Options Defaults
DEFAULT_RISK_FREE_RATE=50000000000000000
DEFAULT_VOLATILITY=800000000000000000
DEFAULT_EXPIRY_DURATION_DAYS=7
